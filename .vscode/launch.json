      "request": "launch",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:([0-9]+)",
        "uriFormat": "http://127.0.0.1:%s/?e1=debug",
        "action": "debugWithChrome"
      },
      "presentation": {
        "group": "経済",
        "order": 0
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm run dev"
    },
