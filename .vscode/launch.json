{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "自律: デバッグ画面（最新 v22）",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:([0-9]+)",
        "uriFormat": "http://127.0.0.1:%s/?village=land-economy&wood=energy",
        "action": "debugWithChrome"
      },
      "presentation": {
        "group": "01 自律生活（現在）",
        "order": 1
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm run dev"
    },
    {
      "name": "自律: 90日計測（v22）",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "01 自律生活（現在）",
        "order": 2
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm run autonomy:village -- 90 --scenario land-energy-effort"
    },
    {
      "name": "自律: 保存記録の再実行（v22）",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "01 自律生活（現在）",
        "order": 3
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm run autonomy:village -- replay fixtures/recordings/autonomous-village-energy-effort-90.v2.json.gz"
    },
    {
      "name": "比較: デバッグ画面（v19・食料行程）",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:([0-9]+)",
        "uriFormat": "http://127.0.0.1:%s/?village=land-economy&wood=plan",
        "action": "debugWithChrome"
      },
      "presentation": {
        "group": "02 比較",
        "order": 1
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm run dev"
    },
    {
      "name": "比較: デバッグ画面（v20・従来の身体）",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:([0-9]+)",
        "uriFormat": "http://127.0.0.1:%s/?village=land-economy&wood=sleep",
        "action": "debugWithChrome"
      },
      "presentation": {
        "group": "02 比較",
        "order": 2
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm run dev"
    },
    {
      "name": "ゲーム: ブラウザで起動",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:([0-9]+)",
        "uriFormat": "http://127.0.0.1:%s",
        "action": "debugWithChrome"
      },
      "presentation": {
        "group": "03 本編ゲーム",
        "order": 1
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm run dev"
    },
    {
      "name": "ゲーム: 90日計測（外交・軍事・無策を選択）",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "03 本編ゲーム",
        "order": 2
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm run sim -- --scenario pass_and_harvest --seed 240924 --days 90 --path ${input:gamePath}"
    },
    {
      "name": "検証: 型検査",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "04 検証",
        "order": 1
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm run typecheck"
    },
    {
      "name": "検証: 単体・シナリオテスト",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "04 検証",
        "order": 2
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm test"
    },
    {
      "name": "検証: 本番ビルド",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "04 検証",
        "order": 3
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm run build"
    },
    {
      "name": "検証: コンテンツ検査",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "04 検証",
        "order": 4
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm run content:validate"
    },
    {
      "name": "検証: 会戦fixture",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "04 検証",
        "order": 5
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm run fixtures"
    },
    {
      "name": "検証: ブラウザテスト",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "04 検証",
        "order": 6
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm run test:browser"
    },
    {
      "name": "性能: 1000人ベンチマーク",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "05 性能",
        "order": 1
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm run bench -- --profile world-1000 --days 100 --warmup-days 10"
    },
    {
      "name": "旧試作: デバッグ画面を選択",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:([0-9]+)",
        "uriFormat": "http://127.0.0.1:%s/?${input:legacyScreen}",
        "action": "debugWithChrome"
      },
      "presentation": {
        "group": "90 旧試作",
        "order": 1
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm run dev"
    },
    {
      "name": "旧試作: CLI計測を選択",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "90 旧試作",
        "order": 2
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" ${input:legacyMeasurement}"
    }
  ],
  "inputs": [
    {
      "id": "gamePath",
      "type": "pickString",
      "description": "本編ゲームの90日計測経路を選択",
      "options": [
        {
          "label": "外交",
          "value": "diplomacy"
        },
        {
          "label": "軍事",
          "value": "military"
        },
        {
          "label": "無策",
          "value": "idle"
        }
      ],
      "default": "diplomacy"
    },
    {
      "id": "legacyScreen",
      "type": "pickString",
      "description": "旧試作の画面を選択（現在のv22とは独立）",
      "options": [
        {
          "label": "自律: 制度なし採集生活の空間デバッグ画面",
          "value": "individual=life"
        },
        {
          "label": "自律: S個人市場の空間デバッグ画面",
          "value": "individual=market"
        },
        {
          "label": "自律: 食事と個人備蓄の空間デバッグ画面",
          "value": "individual=living"
        },
        {
          "label": "自律 A1: 作業場デバッグ画面",
          "value": "a1=debug"
        },
        {
          "label": "自律 A2: 20人経済の空間デバッグ画面",
          "value": "e1=a2"
        },
        {
          "label": "自律 A3: 所得試作の空間デバッグ画面",
          "value": "e1=a3-income"
        },
        {
          "label": "経済 E1: 空間デバッグ画面",
          "value": "e1=debug"
        },
        {
          "label": "経済 L1: 物体木デバッグ画面",
          "value": "e1=v2"
        }
      ],
      "default": "individual=living"
    },
    {
      "id": "legacyMeasurement",
      "type": "pickString",
      "description": "旧試作のCLI計測を選択（現在のv22とは独立）",
      "options": [
        {
          "label": "自律: 制度なし採集生活の30日計測",
          "value": "npm run autonomy:life -- 30"
        },
        {
          "label": "自律: S個人市場の7日計測",
          "value": "npm run autonomy:market -- 7"
        },
        {
          "label": "自律: 食事と個人備蓄の30日計測",
          "value": "npm run autonomy:living -- 30"
        },
        {
          "label": "自律: 食事と個人備蓄の90日計測",
          "value": "npm run autonomy:living -- 90"
        },
        {
          "label": "自律: 起床と情報到達の8時間実験",
          "value": "npm run autonomy:work -- 8"
        },
        {
          "label": "自律: 90日生活の算術実行可能性",
          "value": "npm run autonomy:feasibility"
        },
        {
          "label": "自律: 5人の90日生活",
          "value": "npm run autonomy:village -- 90"
        },
        {
          "label": "自律 A1: 二人と一つの道具",
          "value": "npm run autonomy:a1"
        },
        {
          "label": "自律 A2: 20人経済の3日計測",
          "value": "npm run autonomy:a2"
        },
        {
          "label": "自律 A3: 所得と欠食の3日計測",
          "value": "npm run autonomy:a3:income"
        },
        {
          "label": "自律 A3: 20人経済の90日計測",
          "value": "npm run autonomy:a3:income -- baseline --days 90"
        },
        {
          "label": "経済 E0: 90日基準計測",
          "value": "npm run economy:baseline"
        },
        {
          "label": "経済 E1: 基準3日",
          "value": "npm run economy:e1 -- baseline"
        },
        {
          "label": "経済 E1: 運搬人欠勤",
          "value": "npm run economy:e1 -- carrier-absent"
        },
        {
          "label": "経済 E1: 買物係の資金不足",
          "value": "npm run economy:e1 -- buyer-no-money"
        },
        {
          "label": "経済 E1: 農民欠勤",
          "value": "npm run economy:e1 -- farmer-absent"
        },
        {
          "label": "経済 L1: 物体木の基準3日",
          "value": "npm run economy:e1:v2 -- baseline"
        }
      ],
      "default": "npm run autonomy:village -- 90"
    }
  ]
}
