{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ゲーム: ブラウザで起動",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:([0-9]+)",
        "uriFormat": "http://127.0.0.1:%s",
        "action": "debugWithChrome"
      },
      "presentation": {
        "group": "ゲーム",
        "order": 1
      },
      "command": "PATH=\"$HOME/.local/node/bin:$PATH\" npm run dev"
    },
    {
      "name": "経済 E1: 空間デバッグ画面",
