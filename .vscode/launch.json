{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ゲーム: ブラウザで起動",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${env:HOME}/.local/node/bin/npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "env": { "PATH": "${env:HOME}/.local/node/bin:${env:PATH}" },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "http://127\\.0\\.0\\.1:([0-9]+)",
        "uriFormat": "http://127.0.0.1:%s",
        "action": "debugWithChrome"
      },
      "presentation": { "group": "ゲーム", "order": 1 }
    },
    {
      "name": "90日: 外交",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${env:HOME}/.local/node/bin/npm",
      "runtimeArgs": ["run", "sim", "--", "--scenario", "pass_and_harvest", "--seed", "240924", "--days", "90", "--path", "diplomacy"],
      "cwd": "${workspaceFolder}",
      "env": { "PATH": "${env:HOME}/.local/node/bin:${env:PATH}" },
      "console": "integratedTerminal",
      "presentation": { "group": "ゲーム", "order": 2 }
    },
